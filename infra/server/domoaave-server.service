[Unit]
Description=Domoaave Alert Server
After=network.target

[Service]
User=jehrlich
WorkingDirectory=/home/jehrlich/domoaave
Environment="API_KEY=xxxxx"
Environment="TELEGRAM_TOKEN=xxxx"
Environment="CHAT_ID=xxxxxx"
Environment="EMAIL_TO=xxxxxx"
ExecStart=/home/jehrlich/domoaave/venv/bin/gunicorn\
      -w 2\
      -b 0.0.0.0:6000\
      --certfile /home/jehrlich/domoaave/certs/cert.pem \
      --keyfile /home/jehrlich/domoaave/certs/key.pem \
      server:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

